# Google Gemini API Key (for LLM generation and Multimodal Vision OCR)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Tavily API Key (for real-time web search fallback)
# Get a free key at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Groq API Key (Optional alternative LLM: Llama-3.3-70B / Llama-3.1-8B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Tracing & Observability (Optional)
# Get a key at: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Research-Agent-Citations
